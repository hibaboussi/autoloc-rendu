    {
      "name": "08 - Contrats et paiements (cascade)",
      "item": [
        {
          "name": "[200] Lister les contrats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/contrats"
          }
        },
        {
          "name": "[201] Créer un contrat avec son paiement (cascade)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const contrat = pm.response.json();",
                  "pm.environment.set('contratId', contrat.idContrat);",
                  "pm.environment.set('paiementId', contrat.paiementId);",
                  "pm.test('Le paiement est créé avec le contrat', () => pm.expect(contrat.paiementId).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
