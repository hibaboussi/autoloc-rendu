{
  "info": {
    "_postman_id": "8624d28e-7dc5-4efa-b6ee-a0699f4e3a15",
    "name": "AutoLoc - Atelier 5",
    "description": "Scénario de validation CRUD des neuf ressources AutoLoc, cas 400/404, paiement créé en cascade depuis un contrat, et nettoyage dans l'ordre des dépendances. Utiliser avec l'environnement AutoLoc - local et exécuter la collection dans l'ordre.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runId')) { pm.environment.set('runId', Date.now().toString()); }"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const match = pm.info.requestName.match(/^\\[(\\d{3})\\]/);",
          "if (match) {",
          "  const expected = Number(match[1]);",
          "  pm.test(`Réponse HTTP ${expected}`, () => pm.response.to.have.status(expected));",
          "}"
        ]
      }
    }
  ],
